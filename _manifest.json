{
  "manifest_version": 2,
  "id": "com.0-hz.lunagentic-research-swarm",
  "version": "0.1.0",
  "name": "麦麦深度调查组 (Lunagentic Research Swarm)",
  "description": "以 agentic research swarm 架构进行持续、多智能体深度调查；结合价格有竞争力的快速模型与大型知识模型，通过多代专职 agent、动态 credits、模型路由和上下文优化，提供近似可预测的时间与成本特征。",
  "author": {
    "name": "kes",
    "url": "https://github.com/yufei-pan"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/yufei-pan/maibot-lunagentic-research-swarm"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.7.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "pydantic",
      "version_spec": ">=2.10.0"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.28.0"
    },
    {
      "type": "python_package",
      "name": "ddgs",
      "version_spec": ">=9.14.4,<10.0.0"
    },
    {
      "type": "python_package",
      "name": "lancedb",
      "version_spec": ">=0.34.0,<0.35.0"
    }
  ],
  "capabilities": [
    "api.call",
    "api.list",
    "chat.get_all_streams",
    "chat.get_group_streams",
    "chat.get_private_streams",
    "config.get",
    "knowledge.search",
    "llm.embed",
    "llm.generate",
    "llm.generate_with_tools",
    "maisaka.context.append",
    "maisaka.proactive.trigger",
    "message.build_readable",
    "message.get_by_id",
    "message.get_by_time",
    "message.get_by_time_in_chat",
    "message.get_recent",
    "person.get_id",
    "person.get_id_by_name",
    "person.get_value",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
