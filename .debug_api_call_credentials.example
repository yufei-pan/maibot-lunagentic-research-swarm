# 本地真实 LLM 调试凭证（勿提交）。复制本文件为 `.debug_api_call_credentials` 并填写。
# OpenAI-compatible Chat Completions：POST {base_url}/chat/completions

base_url = "https://your-openai-compatible-endpoint.example/v1"
api_key = "YOUR_API_KEY"
model = "your-local-model-id"

# 可选
temperature = 1.0
timeout_seconds = 300
# max_tokens = 2048

# live E2E / thorough 超时（秒）
e2e_timeout_seconds = 180
thorough_timeout_seconds = 900

# 真实 web_search 工具层（live_llm_live_tools）。默认关闭。
web_search_enabled = false

# 搜索配置必须放在 [web_search] 表内，勿与根级 timeout_seconds 混写（会 TOML 重名报错）。
# [web_search]
# enabled_engines = ["duckduckgo"]
# timeout_seconds = 30
# max_results = 5
# searxng_url = "http://127.0.0.1:8080"
# tavily_api_key = ""
# you_base_url = ""
# you_api_key = ""
