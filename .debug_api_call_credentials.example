# 本地真实 LLM 调试凭证（勿提交）。复制本文件为 `.debug_api_call_credentials` 并填写。
# OpenAI-compatible Chat Completions：POST {base_url}/chat/completions

base_url = "https://your-openai-compatible-endpoint.example/v1"
api_key = "YOUR_API_KEY"
model = "grok-4.5-xhigh"

# 可选
temperature = 0.2
timeout_seconds = 180
# max_tokens = 2048

# live E2E / thorough 超时（秒）
e2e_timeout_seconds = 180
thorough_timeout_seconds = 900

# 真实 web_search 工具层（live_llm_live_tools）。默认关闭。
web_search_enabled = false
# [web_search]
# provider = "ddgs"
# max_results = 5
